      "dot": "emerald",
      "title": "Main journey",
      "items": [
        "Customer posts a request; it stays open 30 days",
        "Repairer sends a quote, which also opens a chat",
        "Customer accepts: order is created as paid (Stripe not built yet), other quotes rejected",
        "Order: paid → in progress → repaired → completed"
      ]
    },
    {
      "dot": "amber",
      "title": "Cancelling",
      "items": [
        "Either side can cancel while the order is paid",
        "Request goes back to open and rejected quotes become pending again"
      ]
    },
    {
      "dot": "cyan",
      "title": "Chat",
      "items": [
        "One conversation per request and repairer; repairers can also start one with a question",
        "Open chat polls every 5 s and on tab focus; header unread badge refreshes every 30 s",
        "Contact details before booking: warning shown, message flagged, not blocked"
      ]
    },
