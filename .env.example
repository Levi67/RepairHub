# Copy to .env for local development. On Vercel, set these under Project → Settings → Environment Variables.

# Postgres connection string.
# Local: the Docker database from compose.yaml (pnpm db:start).
# Vercel: Supabase → Connect → "Transaction pooler" URI (port 6543).
DATABASE_URL="postgres://repairhub:repairhub@localhost:5432/repairhub"

# Public URL of the app, e.g. http://localhost:5173 or https://repairhub.vercel.app
ORIGIN="http://localhost:5173"

# Better Auth secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Supabase Storage for request photos (Supabase → Project Settings → API Keys).
# There is no local storage in Docker, so local development uses the Supabase project too,
# with its own bucket. Create the bucket once with: pnpm storage:setup
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
STORAGE_BUCKET="request-photos-dev"

# Stripe Connect in test mode (Stripe Dashboard → Developers → API keys / Webhooks).
# Leave empty to run without Stripe: then anyone can send quotes. See README "Stripe".
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# "true" = repairers need an active payout account before sending quotes. Leave off for testing.
REQUIRE_PAYOUT_ACCOUNT=""

# Email of the super admin account (always admin, extra tools in /admin). Leave empty for none.
SUPER_ADMIN_EMAIL=""

# Secret for the daily background jobs (/api/cron): expire requests/quotes, cancel unpaid orders,
# auto-confirm orders after 7 days. Generate with: openssl rand -hex 32. Leave empty locally;
# the super admin can run them by hand under /admin/protokoll.
CRON_SECRET=""
