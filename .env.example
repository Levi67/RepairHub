# Copy to .env for local development. On Vercel, set these under Project → Settings → Environment Variables.

# Postgres connection string.
# Local: the Docker database from compose.yaml (pnpm db:start).
# Vercel: Supabase → Connect → "Transaction pooler" URI (port 6543).
DATABASE_URL="postgres://repairhub:repairhub@localhost:5432/repairhub"

# Public URL of the app, e.g. http://localhost:5173 or https://repairhub.vercel.app
ORIGIN="http://localhost:5173"

# Better Auth secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Supabase Storage for request photos (Supabase → Project Settings → API Keys).
# There is no local storage in Docker, so local development uses the Supabase project too,
# with its own bucket. Create the bucket once with: pnpm storage:setup
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
STORAGE_BUCKET="request-photos-dev"
